    <script>
        function toggleMenu() {
            document.getElementById('sideMenu').classList.toggle('active');
            document.getElementById('menuOverlay').classList.toggle('active');
        }

        document.addEventListener('DOMContentLoaded', () => {
            AOS.init({ once: true, offset: 100 });
            particlesJS("particles-js", {
                "particles": { "number": { "value": 40 }, "color": { "value": "#00d4ff" }, "shape": { "type": "circle" }, "opacity": { "value": 0.2 }, "size": { "value": 2 }, "line_linked": { "enable": true, "distance": 150, "color": "#00d4ff", "opacity": 0.1 }, "move": { "enable": true, "speed": 1 } }
            });

            const proyectos = [
                { id: "ventas", titulo: "Financial Overview", descripcion: "Interactive historical Sales analysis report (2015-2017). Data modeling and ETL. Interactive dashboard in Power BI.", keywords: "finance, sales, power bi, dax, etl", link: "ventas-en.html" },
                { id: "almacen", titulo: "Warehouse Control (BPMN)", descripcion: "End-to-End logistics process modeling in Bizagi.", keywords: "logistics, warehouse, processes, bizagi", link: "proyecto-almacen-en.html" },
                { id: "sql", titulo: "Corporate Data Warehouse", descripcion: "Data Warehouse construction with Medallion Architecture and EDA using SQL Server.", keywords: "sql, data warehouse, etl, eda, architecture", link: "proyecto-sql-en.html" }
            ];

            const searchInput = document.getElementById('searchInput');
            const searchResults = document.getElementById('searchResults');

            function resaltarTexto(texto, busqueda) {
                if (!busqueda) return texto;
                const regex = new RegExp(`(${busqueda})`, 'gi');
                return texto.replace(regex, '<span class="highlight-cyan">$1</span>');
            }

            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                searchResults.innerHTML = ''; 

                if (query.length > 0) {
                    const filtrados = proyectos.filter(p => 
                        p.titulo.toLowerCase().includes(query) || 
                        p.descripcion.toLowerCase().includes(query) || 
                        p.keywords.toLowerCase().includes(query)
                    );

                    if (filtrados.length > 0) {
                        filtrados.forEach(proyecto => {
                            let descCorta = proyecto.descripcion.length > 100 ? proyecto.descripcion.substring(0, 100) + '...' : proyecto.descripcion;
                            const tituloResaltado = resaltarTexto(proyecto.titulo, query);
                            const descResaltada = resaltarTexto(descCorta, query);

                            const a = document.createElement('a');
                            a.href = proyecto.link;
                            a.className = 'search-item';
                            a.innerHTML = `<div class="search-item-title">${tituloResaltado}</div><div class="search-item-desc">${descResaltada}</div>`;
                            searchResults.appendChild(a);
                        });
                    } else {
                        searchResults.innerHTML = '<div class="no-results">No matches found...</div>';
                    }
                    searchResults.classList.add('active');
                } else {
                    searchResults.classList.remove('active');
                }
            });

            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });
        });
    </script>
